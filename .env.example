SATMOD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SATMOD_MAX_UPLOAD_BYTES=4194304
# SATMOD_MODEL_PATH=models/cnn_weights.npz

# Optional fixed ports; otherwise the launcher selects available defaults.
# SATMOD_API_PORT=8000
# SATMOD_FRONTEND_PORT=5173

# Persistent single-workspace metadata and managed captures (default .satmod/).
# SATMOD_DATA_DIR=/absolute/path/to/private-workspace
# SATMOD_CAPTURE_UPLOAD_BYTES=134217728
# SATMOD_STORAGE_BYTES=1073741824
# Public hosting: set both; the access token is never committed or logged.
# SATMOD_PUBLIC=1
# SATMOD_ACCESS_TOKEN=replace-with-a-long-random-secret
